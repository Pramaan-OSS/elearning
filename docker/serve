#!/bin/sh
set -eu
cd /app
python docker/setup.py
node /app/vendor/framework/socketio.js > /app/.runtime/bench/logs/socket.log 2>&1 &
socket_pid=$!
cd /app/.runtime/bench/sites
python -m frappe.utils.bench_helper frappe worker > ../logs/worker.log 2>&1 &
worker_pid=$!
scheduler_pid=""
if [ "$(cat ../.outside-configured)" = yes ]; then
  python -m frappe.utils.bench_helper frappe schedule > ../logs/scheduler.log 2>&1 &
  scheduler_pid=$!
fi
frontend_pid=""
server_pid=""
cleanup() { kill "$socket_pid" "$worker_pid" ${scheduler_pid:+"$scheduler_pid"} ${frontend_pid:+"$frontend_pid"} ${server_pid:+"$server_pid"} 2>/dev/null || true; }
trap cleanup EXIT INT TERM
if [ "${ELEARNING_RUN_MODE:-production}" = development ]; then
  (cd /app/frontend && node node_modules/vite/bin/vite.js --host 0.0.0.0 --port 8080 --strictPort) > ../logs/frontend.log 2>&1 &
  frontend_pid=$!
  python -m frappe.utils.bench_helper frappe --site "$ELEARNING_SITE_NAME" serve --port 8000 --noreload &
else
  gunicorn --bind 0.0.0.0:8000 --workers 2 --threads 2 --timeout 120 --access-logfile - --error-logfile - lms.wsgi:application &
fi
server_pid=$!
wait "$server_pid"
