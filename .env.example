# Only this value must be filled in. Everything else is generated or defaulted.
PRAMAAN_API_KEY=

# Optional: the platform base URL. Leave empty for the default.
# PRAMAAN_BASE_URL=

# Optional: tax classification for course checkout and reminder payment links.
PRAMAAN_TAX_CATEGORY=edtech

# The values below are generated on first start and written back here.
# Never commit .env. Back it up together with the site's volumes.

ELEARNING_SITE_NAME=
ELEARNING_LOCAL_PORT=
ELEARNING_DB_PASSWORD=
ELEARNING_ADMIN_PASSWORD=
ELEARNING_ENCRYPTION_KEY=
ELEARNING_COMPOSE_PROJECT=
